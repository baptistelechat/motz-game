# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key #Publishable and secret API keys tab
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key #Legacy anon, service_role API keys tab
DATABASE_URL="postgres://[user]:[password]@[host]:[port]/[db]" # Connect > URI > > Primary Database > Session Pooler

# Update this with your Turnstile site key from your account settings
# https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-that-start-with-0

# Enable E2E bypass button
NEXT_PUBLIC_IS_E2E=false
