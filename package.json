{
  "name": "motz-game",
  "version": "0.1.0",
  "description": "Jeu de mots multijoueur temps réel avec design Pixel-Pop",
  "private": true,
  "scripts": {
    "remove-bg": "tsx scripts/remove-bg.ts",
    "remove-bg:avatar": "tsx scripts/remove-bg.ts \"public/assets/avatar/*.png\"",
    "pixelate": "tsx scripts/pixelate.ts",
    "pixelate:avatar": "tsx scripts/pixelate.ts \"src/assets/avatar/*.png\" \"public/assets/avatar/\" --pixel-size 32 --keep-resolution",
    "dev": "next dev --turbo",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:e2e": "cross-env NEXT_PUBLIC_IS_E2E=true playwright test",
    "test:e2e:ui": "cross-env NEXT_PUBLIC_IS_E2E=true playwright test --ui",
    "seed:game": "tsx scripts/seed-game.ts"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@marsidev/react-turnstile": "^1.4.1",
    "@nsmr/pixelart-react": "^2.0.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@tailwindcss/postcss": "^4.1.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.27.2",
    "framer-motion": "^12.27.5",
    "glob": "^13.0.0",
    "nanoid": "^5.1.6",
    "next": "latest",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.18",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.18",
    "yargs": "^18.0.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.2.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "jsdom": "^27.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "packageManager": "pnpm@9.9.0+sha512.60c18acd138bff695d339be6ad13f7e936eea6745660d4cc4a776d5247c540d0edee1a563695c183a66eb917ef88f2b4feb1fc25f32a7adcadc7aaf3438e99c1"
}
